{
  "name": "payment-service",
  "version": "0.1.0",
  "private": true,
  "description": "Microservicio de pagos - dueño exclusivo del estado de un pago, integrado a Stripe (sandbox).",
  "main": "dist/server.js",
  "scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/server.js",
  "migrate": "node scripts/migrate.js",
  "test": "jest",
  "test:unit": "jest tests/unit",
  "test:integration": "jest tests/integration --runInBand",
  "test:db": "jest tests/integration/repositories tests/integration/messaging --runInBand",
  "test:watch": "jest --watch"
},
  "dependencies": {
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "stripe": "^16.8.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "@types/jest": "^29.5.12",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
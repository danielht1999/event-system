# payment-service — copiar a .env y completar

# Servidor
PORT=4000

# Base de datos propia (nunca compartida con el monolito)
DATABASE_URL=postgres://payment_user:payment_pass@localhost:5433/payment_service

# Redis (reutilizado del monolito, con stream dedicado 'payments.events')
REDIS_URL=redis://localhost:6379

# Autenticación servicio-a-servicio con el monolito (mismo valor en ambos lados)
PAYMENT_SERVICE_HMAC_SECRET=changeme-shared-secret

# Stripe (test mode / sandbox)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

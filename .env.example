# ============================================
# TEMPLATE PARA NUEVOS DESARROLLADORES
# ============================================

PORT=3000
NODE_ENV=development
LOG_DIR=logs

# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_system
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================
# JWT - GENERA TU PROPIO SECRETO
# ============================================
JWT_SECRET=tu-secreto-generado-aqui

# ============================================
# SMTP - Recomendado: Mailtrap para desarrollo
# Regístrate en https://mailtrap.io y obtén tus credenciales
# ============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_mailtrap
SMTP_PASS=tu_password_mailtrap
SMTP_FROM_NAME="EVENTIFY Command Center"
SMTP_FROM_EMAIL=noreply@eventify.com

# ============================================
# URLs DE LA PLATAFORMA
# ============================================
PLATFORM_TERMS_URL=https://eventify.com/terms
PLATFORM_PRIVACY_URL=https://eventify.com/privacy